# Required: the live voice interviewer (Gemini Live). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Claude grades every call when this is set. Without it, grade by hand with the review prompt.
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
