{
  "name": "voice-interviewer",
  "version": "0.1.0",
  "description": "Live AI voice interviewer: Gemini Live asks, you answer out loud, Claude scores every answer. Bring your own questions.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/app.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "review": "tsx scripts/review.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run -s typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
